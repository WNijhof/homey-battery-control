        {
          "id": "max_soc",
          "type": "number",
          "label": {
            "en": "Maximum charge level",
            "nl": "Maximaal laadniveau"
          },
          "value": 100,
          "min": 50,
          "max": 100,
          "units": {
            "en": "%"
          },
          "hint": {
            "en": "The battery never charges above this level. 90–95 % can extend battery life slightly.",
            "nl": "Boven dit laadniveau laadt de batterij nooit. 90–95 % kan de levensduur iets verlengen."
          }
        },
        {
          "id": "efficiency",
          "type": "number",
          "label": {
            "en": "Round-trip efficiency",
            "nl": "Rendement (heen en terug)"
