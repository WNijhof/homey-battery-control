  "settings": [
    {
      "type": "group",
      "label": {
        "en": "Connection",
        "nl": "Verbinding"
      },
      "children": [
        {
          "id": "p1_ip",
          "type": "text",
          "label": {
            "en": "HomeWizard P1 IP address",
            "nl": "HomeWizard P1 IP-adres"
          },
          "value": "",
          "hint": {
            "en": "IP address of the HomeWizard P1 meter. Give it a fixed address in your router.",
            "nl": "IP-adres van de HomeWizard P1-meter. Geef hem een vast adres in je router."
          }
        },
        {
          "id": "p1_token",
          "type": "password",
          "label": {
            "en": "HomeWizard API v2 token (optional)",
            "nl": "HomeWizard API v2-token (optioneel)"
          },
          "hint": {
            "en": "Leave empty to use local API v1. Obtain a token via Repair on this device (press the button on the P1 meter).",
            "nl": "Leeg = lokale API v1. Een token haal je op via Repareren bij dit apparaat (knop op de P1-meter indrukken)."
          },
          "value": ""
        },
        {
          "id": "interval",
          "type": "number",
          "label": {
            "en": "Control interval",
            "nl": "Regelinterval"
          },
          "value": 5,
          "min": 2,
          "max": 60,
          "units": {
            "en": "s"
          },
          "hint": {
            "en": "How often the app reads the meter and adjusts the battery. 5 s works well; shorter reacts faster but causes more network traffic.",
            "nl": "Hoe vaak de app de meter uitleest en de batterij bijstuurt. 5 s werkt goed; korter reageert sneller maar geeft meer netwerkverkeer."
          }
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Simulation",
        "nl": "Simulatie"
      },
      "children": [
        {
          "id": "sim_start_soc",
          "type": "number",
          "label": {
            "en": "Start level (%)",
            "nl": "Startniveau (%)"
          },
          "hint": {
            "en": "Changing this value resets the simulated battery to this level.",
            "nl": "Als je deze waarde wijzigt, begint de gesimuleerde batterij opnieuw op dit niveau."
          },
          "value": 50,
          "min": 0,
          "max": 100
        },
        {
          "id": "sim_rte",
          "type": "number",
          "label": {
            "en": "Round-trip efficiency at 800 W (%)",
            "nl": "Rendement heen en terug bij 800 W (%)"
          },
          "hint": {
            "en": "AC to AC. Reviews measured 87–88 % for the SolarFlow 2400 AC+ (Zendure claims up to 93 %).",
            "nl": "Van stopcontact naar stopcontact. Reviews maten 87–88 % bij de SolarFlow 2400 AC+ (Zendure noemt tot 93 %)."
          },
          "value": 88,
          "min": 60,
          "max": 98
        },
        {
          "id": "sim_overhead_w",
          "type": "number",
          "label": {
            "en": "Fixed conversion loss (W)",
            "nl": "Vast omzettingsverlies (W)"
          },
          "hint": {
            "en": "Loss per direction while charging or discharging, regardless of the power. Makes low powers less efficient: with 8 W the round trip is about 81 % at 150 W (reviews: 78–82 % at 100–200 W).",
            "nl": "Verlies per richting tijdens laden of ontladen, los van het vermogen. Maakt kleine vermogens minder zuinig: met 8 W is het rendement ongeveer 81 % bij 150 W (reviews: 78–82 % bij 100–200 W)."
          },
          "value": 8,
          "min": 0,
          "max": 50
        },
        {
          "id": "sim_standby_w",
          "type": "number",
          "label": {
            "en": "Standby from the grid (W)",
            "nl": "Stand-by uit het net (W)"
          },
          "hint": {
            "en": "Power the idle battery draws from the socket (measured: 0.7 W).",
            "nl": "Vermogen dat de batterij in rust uit het stopcontact haalt (gemeten: 0,7 W)."
          },
          "value": 0.7,
          "min": 0,
          "max": 20,
          "step": 0.1
        },
        {
          "id": "sim_idle_drain_w",
          "type": "number",
          "label": {
            "en": "Standby from the battery (W)",
            "nl": "Stand-by uit de accu (W)"
          },
          "hint": {
            "en": "Power the idle battery takes from its own cells (measured: about 2.7 W, roughly 65 Wh per day).",
            "nl": "Vermogen dat de batterij in rust uit de eigen accu haalt (gemeten: circa 2,7 W, ongeveer 65 Wh per dag)."
          },
          "value": 2.7,
          "min": 0,
          "max": 20,
          "step": 0.1
        },
        {
          "id": "sim_delay_s",
          "type": "number",
          "label": {
            "en": "Response delay (s)",
            "nl": "Reactietijd (s)"
          },
          "hint": {
            "en": "Time before a new set-point takes effect (reviews: within a few seconds).",
            "nl": "Tijd voordat een nieuw vermogen ingaat (reviews: binnen een paar seconden)."
          },
          "value": 3,
          "min": 0,
          "max": 30
        },
        {
          "id": "sim_ramp_wps",
          "type": "number",
          "label": {
            "en": "Ramp rate (W per second)",
            "nl": "Opregelsnelheid (W per seconde)"
          },
          "hint": {
            "en": "How fast the power changes after the response delay.",
            "nl": "Hoe snel het vermogen daarna verandert."
          },
          "value": 200,
          "min": 10,
          "max": 5000
        },
        {
          "id": "sim_export_fee",
          "type": "number",
          "label": {
            "en": "Feed-in fee without net metering (€/kWh)",
            "nl": "Terugleverkosten zonder saldering (€/kWh)"
          },
          "hint": {
            "en": "For the comparison without net metering (from 2027): export earns the market price incl. VAT minus this amount.",
            "nl": "Voor de vergelijking zonder saldering (vanaf 2027): teruglevering levert de marktprijs incl. btw op, min dit bedrag."
          },
          "value": 0,
          "min": -0.5,
          "max": 0.5,
          "step": 0.01
        },
        {
          "id": "sim_reset_stats",
          "type": "checkbox",
          "label": {
            "en": "Clear simulation statistics",
            "nl": "Simulatie-statistieken wissen"
          },
          "hint": {
            "en": "Tick and save to start the comparison again.",
            "nl": "Aanvinken en opslaan om de vergelijking opnieuw te beginnen."
          },
          "value": false
        }
      ]
    },
