          "value": 800,
          "min": 100,
          "max": 2400,
          "units": {
            "en": "W"
          },
          "hint": {
            "en": "800 W on a normal wall socket; higher only on a dedicated circuit installed by an electrician",
            "nl": "800 W via een gewoon stopcontact; hoger alleen op een eigen groep, aangelegd door een installateur"
          }
        },
        {
          "id": "min_soc",
          "type": "number",
