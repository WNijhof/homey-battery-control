          "hint": {
            "en": "After enough data (5 kWh charged) the measured efficiency replaces the value above.",
            "nl": "Zodra er genoeg gegevens zijn (5 kWh geladen) vervangt het gemeten rendement de waarde hierboven."
          },
          "value": true
        }
      ]
