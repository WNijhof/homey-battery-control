          "value": 10,
          "min": 0,
          "max": 50,
          "units": {
            "en": "%"
          },
          "hint": {
            "en": "The battery never discharges below this level. Keep it at or above the limit set in the Zendure app.",
            "nl": "Onder dit laadniveau ontlaadt de batterij nooit. Houd dit gelijk aan of hoger dan de grens in de Zendure-app."
          }
